{
  "name": "pi-orca-dispatch",
  "version": "0.2.0",
  "description": "Dispatch the current Pi conversation to a new Orca split pane or opt-in tab that opens with the same folder, model, and tools, leaving the parent session untouched.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "pi-coding-agent", "orca"],
  "repository": { "type": "git", "url": "git+https://github.com/wh3at/pi-orca-dispatch.git" },
  "bugs": { "url": "https://github.com/wh3at/pi-orca-dispatch/issues" },
  "homepage": "https://github.com/wh3at/pi-orca-dispatch#readme",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./index.ts"] },
  "files": ["index.ts", "observer.ts", "src/", "bin/", "README.md", "LICENSE"],
  "scripts": { "test": "node --experimental-strip-types --test tests/*.test.ts", "check": "node --check bin/launch.mjs" }
}
